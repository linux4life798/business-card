# Optional overrides for the schematic INFO1 symbol's CONTACT_* fields.
# Copy to .env and edit. Omitted keys keep the INFO1 value; blank clears it.
# Quoted values are supported. Variable expansion is disabled.
CONTACT_NAME=Alex Example
CONTACT_ROLE=Systems Engineer
CONTACT_COMPANY=
CONTACT_EMAIL=alex@example.com
CONTACT_PHONE=
CONTACT_WEB=example.com
CONTACT_WEB_QR=https://example.com
