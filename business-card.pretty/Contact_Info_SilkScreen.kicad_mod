(footprint "Contact_Info_SilkScreen"
	(version 20260206)
	(generator "pcbnew")
	(generator_version "10.0")
	(layer "F.Cu")
	(descr "Editable contact information with a native vCard 4.0 QR code; 25 mm code with 3 mm quiet margins, knockout for light silkscreen on dark soldermask; CONTACT_WEB is display text, CONTACT_WEB_QR is the full URL encoded in the QR; use single-line vCard-safe text; no pads")
	(tags "contact business card name email phone website silkscreen vCard QR code")
	(property "Reference" "INFO**"
		(at 0 -3 0)
		(layer "F.Fab")
		(hide yes)
		(effects (font (size 1 1) (thickness 0.15)) (justify left))
	)
	(property "Value" "Contact_Info"
		(at 0 14 0)
		(layer "F.Fab")
		(hide yes)
		(effects (font (size 1 1) (thickness 0.15)) (justify left))
	)
	(property "CONTACT_NAME" "Your Name"
		(at 0 0 0)
		(layer "F.Fab")
		(hide yes)
		(effects (font (size 1 1) (thickness 0.15)) (justify left))
	)
	(property "CONTACT_COMPANY" "Your Company"
		(at 0 0 0)
		(layer "F.Fab")
		(hide yes)
		(effects (font (size 1 1) (thickness 0.15)))
	)
	(property "CONTACT_ROLE" "Your Role"
		(at 0 3 0)
		(layer "F.Fab")
		(hide yes)
		(effects (font (size 1 1) (thickness 0.15)) (justify left))
	)
	(property "CONTACT_EMAIL" "you@example.com"
		(at 0 6 0)
		(layer "F.Fab")
		(hide yes)
		(effects (font (size 1 1) (thickness 0.15)) (justify left))
	)
	(property "CONTACT_PHONE" "+1 202-555-0123"
		(at 0 8.5 0)
		(layer "F.Fab")
		(hide yes)
		(effects (font (size 1 1) (thickness 0.15)) (justify left))
	)
	(property "CONTACT_WEB" "example.com"
		(at 0 11 0)
		(layer "F.Fab")
		(hide yes)
		(effects (font (size 1 1) (thickness 0.15)) (justify left))
	)
	(property "CONTACT_WEB_QR" "https://${CONTACT_WEB}"
		(at 0 11 0)
		(layer "F.Fab")
		(hide yes)
		(effects (font (size 1 1) (thickness 0.15)) (justify left))
	)
	(attr exclude_from_pos_files exclude_from_bom allow_missing_courtyard)
	(fp_text user "${CONTACT_NAME}"
		(at 0 0 0)
		(layer "F.SilkS")
		(effects (font (size 2 2) (thickness 0.3)) (justify left))
	)
	(fp_text user "${CONTACT_ROLE}"
		(at 0 3 0)
		(layer "F.SilkS")
		(effects (font (size 1.2 1.2) (thickness 0.18)) (justify left))
	)
	(fp_text user "${CONTACT_EMAIL}"
		(at 0 6 0)
		(layer "F.SilkS")
		(effects (font (size 1.1 1.1) (thickness 0.16)) (justify left))
	)
	(fp_text user "${CONTACT_PHONE}"
		(at 0 8.5 0)
		(layer "F.SilkS")
		(effects (font (size 1.1 1.1) (thickness 0.16)) (justify left))
	)
	(fp_text user "${CONTACT_WEB}"
		(at 0 11 0)
		(layer "F.SilkS")
		(effects (font (size 1.1 1.1) (thickness 0.16)) (justify left))
	)
	(barcode
		(at -17 5.5 0)
		(layer "F.SilkS")
		(size 25 25)
		(text "BEGIN:VCARD\r\nVERSION:4.0\r\nFN:${CONTACT_NAME}\r\nORG:${CONTACT_COMPANY}\r\nTITLE:${CONTACT_ROLE}\r\nTEL;VALUE=text:${CONTACT_PHONE}\r\nEMAIL:${CONTACT_EMAIL}\r\nURL:${CONTACT_WEB_QR}\r\nEND:VCARD\r\n")
		(text_height 1.27)
		(type qr)
		(ecc_level M)
		(hide yes)
		(knockout yes)
		(margins 3 3)
		(uuid "1d3f3aa2-07d0-43cf-8200-394d751cbf6a")
	)
	(embedded_fonts no)
)
