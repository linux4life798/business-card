(footprint "CJH_Signature_SilkScreen"
	(version 20260206)
	(generator "pcbnew")
	(generator_version "10.0")
	(layer "F.Cu")
	(descr "CJH signature with automatic year, front silkscreen")
	(tags "CJH signature sign off year silkscreen artwork")
	(property "Reference" "SIGN**"
		(at 0 -2 0) (layer "F.Fab") (hide yes)
		(effects (font (size 1 1) (thickness 0.15)))
	)
	(property "Value" "CJH_Signature"
		(at 0 2 0) (layer "F.Fab") (hide yes)
		(effects (font (size 1 1) (thickness 0.15)))
	)
	(property "YEAR" "@{if(beforefirst(dateformat(today()), '-') % 100 < 10, '0', '') + (beforefirst(dateformat(today()), '-') % 100)}"
		(at 0 0 0) (layer "F.Fab") (hide yes)
		(effects (font (size 1 1) (thickness 0.15)))
	)
	(attr exclude_from_pos_files exclude_from_bom allow_missing_courtyard)
	(fp_text user "CJH '${YEAR}"
		(at 0 0 0) (layer "F.SilkS")
		(effects (font (size 1.2 1.2) (thickness 0.2)))
	)
	(embedded_fonts no)
)
